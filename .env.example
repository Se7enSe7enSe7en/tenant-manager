# <?> - change accordingly 

# for the app (pgxpool + goose)
DATABASE_URL=postgres://postgres:<the-password>@127.0.0.1:5432/db?sslmode=disable
PORT=8080

# for goose cli
GOOSE_DBSTRING=postgres://postgres:<the-password>@127.0.0.1:5432/db?sslmode=disable
# note: GOOSE_DBSTRING should be the same with DATABASE_URL
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR="./internal/database/migrations"

# for docker-compose postgres 
POSTGRES_USER=<?> # eg. postgres
POSTGRES_PASSWORD=<?> # eg. postgres
POSTGRES_DB=<?> # eg. db

# for deployment
REMOTE_HOST=<the-vps-ip>