package layout

// The base component of all pages, all pages should be wrapped by this component
templ Base() {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Tenant Manager</title>
			<link rel="icon" type="svg" href="/assets/tenant-manager-logo-dark.svg"/>
			// preloading these assets for optimization
			<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/Libron-Regular.woff2">
			<link rel="preload" as="image" href="/assets/background-patterns/cube-house.svg">

			// tailwind
			<link href="/assets/css/output.css" rel="stylesheet"/>

			// datastar
			<script type="module" src="/assets/js/datastar.js"></script>
			// <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.1/bundles/datastar.js"></script>
		</head>
		<body>
			<main>
				<div id="main-page">
						{ children... }
				</div>
			</main>
		</body>
	</html>
}
