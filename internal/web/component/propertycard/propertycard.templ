package propertycard

import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/component/button"

type PropertyCardProps struct {
	Id         string
	Name       string
	RentAmount string
}

templ PropertyCard(props PropertyCardProps) {
	<div class="h-69 flex flex-col justify-between p-4 bg-card rounded-xl border shadow-sm">
		//// header section
		<div class="h-[30.9%] flex justify-between mb-2 gap-2">
			<div class="flex gap-2">
				// <div class="flex bg-secondary items-center justify-center size-12 rounded-full border">
				// 	// TODO: add if no image condition in the future
				// 	// <span class="text-xl">P</span>
				// </div>
				<div class="flex-col">
					<p class="">{ props.Name }</p>
				</div>
			</div>
			<div class="flex justify-end align-top">
				// status
				<div
					class="flex justify-end h-6"
				>
					<div
						class="flex rounded-full border items-center justify-center gap-3 px-2 font-semibold"
					>
						<span class="flex items-center justify-center">
							<span>○</span>
						</span>
						<span class="">Unoccupied</span>
					</div>
				</div>
			</div>
		</div>
		//// body section
		<div class="h-[50%] flex flex-col pt-2 border-t gap-2">
			<div>
				<p class="text-xs">Address: </p>
				<p>001 test street, brgy. test, Test City</p>
			</div>
			<div>
				<p class="text-xs">Monthly Rent: </p>
				<p>{ props.RentAmount }</p>
			</div>
		</div>
		//// footer section
		<div class="h-[19.1%] flex justify-center border-t pt-2">
			@button.LinkButton(button.LinkButtonArgs{
				Class:   "w-full",
				Variant: "secondary",
				Href:    "/tenant/create?property_id=" + props.Id,
			}) {
				Add tenant
			}
			// @button.Button(button.ButtonArgs{
			// 	Class: "w-full",
			// 	Variant: "secondary",
			// 	Attributes: templ.Attributes{
			// 		"data-on:click": fmt.Sprint(`@get("/tenant/create?property_id=`, props.Id, `")`), // TODO: how to pass a query
			// 	},
			// }) {
			// 	Add tenant
			// }
		</div>
		// <div class="flex justify-between border-t pt-2">
		// 	<div class="flex-col">
		// 		<p class="text-xs">Monthly Rent: </p>
		// 		<p>{ props.RentAmount }</p>
		// 	</div>
		// </div>
	</div>
}
