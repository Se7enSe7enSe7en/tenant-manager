package sidebar

import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/component/button"

templ Sidebar() {
	<div>
		@button.LinkButton(button.LinkButtonArgs{
			Href:    "/dashboard",
			Variant: "outline",
			Class:   "flex",
		}) {
			<div class="flex items-center justify-center gap-3">
				<svg class="size-5 fill-current"><use href="/assets/home-icon.svg"></use></svg>
				<span>Dashboard</span>
			</div>
		}
	</div>
}
