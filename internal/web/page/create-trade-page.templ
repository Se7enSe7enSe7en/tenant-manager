package page

import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/layout"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/button"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/utils"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/form"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/store"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/table"

type CreateTradePageProps struct {
	LeaseId            string
	TenantName         string
	PropertyName       string
	RentValidityPeriod string
	RentAmount         string
	TransactionDate    string
}

templ CreateTradePage(props CreateTradePageProps) {
	{{
		signals := utils.Signals("create_trade_signals", store.CreateTradeSignals{
			LeaseId: props.LeaseId,
		})
	}}
	@layout.Default() {
		@form.Form(form.FormArgs{
			ID:     "trade-form",
			Action: "/trade/create",
			Attributes: templ.Attributes{
				"data-signals":            signals.DataSignals,
				"data-on:submit__prevent": "@post('/trade/create')",
			},
		}) {
			<div class="flex flex-col items-center justify-center gap-3">
				<div class="flex flex-col gap-3">
					<div class="flex gap-3">
						// table
						<div class="bg-card rounded-xl p-5 border shadow-sm">
							@table.Table() {
								@table.Caption() {
									Receipt details
								}
								@table.Body() {
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											Tenant Name
										}
										@table.Cell() {
											{ props.TenantName }
										}
									}
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											Property Name
										}
										@table.Cell() {
											{ props.PropertyName }
										}
									}
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											Rent Validity
										}
										@table.Cell() {
											{ props.RentValidityPeriod }
										}
									}
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											Rent Amount
										}
										@table.Cell() {
											{ props.RentAmount }
										}
									}
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-medium"}) {
											Transaction Date
										}
										@table.Cell() {
											{ props.TransactionDate }
										}
									}
								}
							}
						</div>
						// // summary details (old)
						// <div class="bg-card rounded-xl p-5 border shadow-sm h-60 flex flex-col justify-between">
						// 	<p>Receipt details</p>
						// 	<p>Lease id: { props.LeaseId }</p>
						// 	<p>tenant name: { props.TenantName }</p>
						// 	<p>property name: { props.PropertyName }</p>
						// 	<p>rent validity period: { props.RentValidityPeriod }</p>
						// 	<p>rent amount: { props.RentAmount }</p>
						// 	<p>transaction date: { props.TransactionDate }</p>
						// </div>
					</div>
					<div class="flex justify-between">
						@button.LinkButton(button.LinkButtonArgs{
							Variant: "secondary",
							Href:    "/dashboard",
						}) {
							Cancel
						}
						@button.Button(button.ButtonArgs{
							Type: "submit",
						}) {
							Confirm
						}
					</div>
				</div>
			</div>
		}
	}
}
