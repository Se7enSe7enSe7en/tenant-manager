package page

import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/component/form"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/component/input"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/component/button"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/utils"

import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/component/layout"
import "time"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/store"

type CreateTenantPageProps struct {
	PropertyId           string
	DefaultDepositAmount float64
}

templ CreateTenantPage(props CreateTenantPageProps) {
	{{
		signals := utils.Signals("create_tenant_signals", store.CreateTenantSignals{
			PropertyId:      props.PropertyId,
			Name:            "",
			Email:           "",
			PhoneNumber:     "",
			ExpectedRentDay: 1,
			StartDate:       time.Now().Format("2006-01-02"),
			IsMonthAdvance:  false,
			DepositAmount:   props.DefaultDepositAmount,
			NextDueDate:     utils.ComputeNextExpiryDate(time.Now(), 1).Format("Jan 02 2006"),
		})
	}}
	@layout.WithSidebar() {
		<div class="grid grid-cols-12 gap-4">
			<div
				class="p-4 col-span-12 lg:col-start-4 lg:col-span-6 border bg-card"
			>
				@form.Form(form.FormArgs{
					ID:     "tenant-form",
					Class:  "flex flex-col gap-2",
					Action: "/tenant/create",
					Attributes: templ.Attributes{
						"data-signals":            signals.DataSignals,
						"data-on:submit__prevent": "@post('/tenant/create')",
						// note: prevents default behavior of submitting a form, we don't need it because we send data through signals
					},
				}) {
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "name"}) {
							tenant name *
						}
						@input.Input(input.InputArgs{
							ID:          "name",
							Name:        "name",
							Placeholder: "",
							Attributes: templ.Attributes{
								"data-bind": "create_tenant_signals.name", // TODO: figure out a way to have type safety
							},
						})
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "email"}) {
							tenant email *
						}
						@input.Input(input.InputArgs{
							ID:          "email",
							Name:        "email",
							Placeholder: "email@email.com",
							Attributes: templ.Attributes{
								"data-bind": "create_tenant_signals.email",
							},
						})
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "phone_number"}) {
							tenant phone number
						}
						@input.Input(input.InputArgs{
							ID:          "phone_number",
							Name:        "phone_number",
							Placeholder: "0987 654 3210",
							Attributes: templ.Attributes{
								"data-bind": "create_tenant_signals.phone_number",
							},
						})
					}
					// Start date input field
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "start_date"}) {
							lease start date
						}
						@input.Input(input.InputArgs{
							ID:   "start_date",
							Name: "start_date",
							Type: "date",
							// Placeholder: "now()",
							Attributes: templ.Attributes{
								"data-bind":      "create_tenant_signals.start_date",
								"data-on:change": "@post('/ds/tenant/create/compute_next_due_date')",
							},
						})
					}
					// Rent day input field
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "expected_rent_day"}) {
							lease rent day
						}
						@input.Input(input.InputArgs{
							ID:          "expected_rent_day",
							Name:        "expected_rent_day",
							Placeholder: "1",
							Attributes: templ.Attributes{
								"data-bind":      "create_tenant_signals.expected_rent_day",
								"data-on:change": "@post('/ds/tenant/create/compute_next_due_date')",
							},
						})
						@form.FormDescription(form.FormDescriptionArgs{}) {
							Choose a number from 1 to 31, If empty, this will default to the first day of the month which is 1
						}
						// Next due date based on the current start_date and expected_rent_day
						// @form.FormDescription(form.FormDescriptionArgs{}) {
						// 	Next due date: $create_tenant_signals.next_due_date
						// }
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "expected_rent_day"}) {
							lease expected next due date
						}
						@input.Input(input.InputArgs{
							ID:   "next_due_date",
							Name: "next_due_date",
							Attributes: templ.Attributes{
								"data-bind": "create_tenant_signals.next_due_date",
								"readonly":  true,
							},
						})
					}
					// Is Month advance checkbox
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "is_month_advance"}) {
							lease is month advance paid
						}
						@input.Input(input.InputArgs{
							ID:    "is_month_advance",
							Name:  "is_month_advance",
							Type:  "checkbox",
							Class: "w-6",
							Attributes: templ.Attributes{
								"data-bind": "create_tenant_signals.is_month_advance",
							},
						})
					}
					// deposit amount input field
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "deposit_amount"}) {
							lease deposit amount
						}
						@input.Input(input.InputArgs{
							ID:   "deposit_amount",
							Name: "deposit_amount",
							Type: "number",
							Attributes: templ.Attributes{
								"data-bind": "create_tenant_signals.deposit_amount",
								"step":      "0.01",
							},
						})
					}
					// // TODO: Property rent amount can also be edited in this form
					// @form.FormItem(form.FormItemArgs{}) {
					// 	@form.FormLabel(form.FormLabelArgs{For: "rent_amount"}) {
					// 		Rent Amount *
					// 	}
					// 	@input.Input(input.InputArgs{
					// 		ID:          "rent_amount",
					// 		Name:        "rent_amount",
					// 		Type:        "number",
					// 		Placeholder: "15000",
					// 		Attributes: templ.Attributes{
					// 			"data-bind":"property.rent_amount",
					// 			"step": "0.01", // note: by default the input can only take step = 1, meaning whole numbers
					// 		},
					// 	})
					// }
					<div class="flex pt-4 justify-between">
						@button.LinkButton(button.LinkButtonArgs{
							Variant: "outline",
							Href:    "/dashboard",
						}) {
							Back
						}
						@button.Button(button.ButtonArgs{Type: "submit"}) {
							Submit
						}
					</div>
				}
			</div>
		</div>
	}
}
