package page

import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/form"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/input"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/button"
import "github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/layout"

templ RegisterPage() {
	@layout.Base() {
		<div class="flex items-center justify-center w-screen h-screen">
			<div class="border bg-card items-center justify-center p-4 rounded-md flex flex-col gap-4">
				<h1 class="text-xl">Tenant manager</h1>
				@form.Form(form.FormArgs{
					ID:     "register",
					Action: "/register",
					Class:  "flex flex-col gap-4 min-w-xs",
					Attributes: templ.Attributes{
						"data-signals": "{registerError: ''}",
					},
				}) {
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{
							For: "email",
						}) {
							email *
						}
						@input.Input(input.InputArgs{
							Type:     "email",
							Name:     "email",
							ID:       "email",
							Required: true,
						})
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{
							For: "password",
						}) {
							password *
						}
						@input.Input(input.InputArgs{
							Type: "password",
							Name: "password",
							ID:   "password",
						})
						@form.FormDescription(form.FormDescriptionArgs{}) {
							password must be at least 8 characters
						}
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{
							For: "confirm-password",
						}) {
							confirm password *
						}
						@input.Input(input.InputArgs{
							Type: "password",
							Name: "confirm-password",
							ID:   "confirm-password",
						})
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{
							For: "name",
						}) {
							name
						}
						@input.Input(input.InputArgs{
							Type: "name",
							Name: "name",
							ID:   "name",
						})
					}
					<p data-show="$registerError" data-text="$registerError" class="text-sm text-destructive"></p>
					@button.Button(button.ButtonArgs{
						Type: "submit",
					}) {
						Register
					}
					@button.LinkButton(button.LinkButtonArgs{
						Href:    "/login",
						Variant: "link",
					}) {
						Back to Login
					}
				}
			</div>
		</div>
	}
}
