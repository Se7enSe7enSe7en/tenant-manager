package page

import (
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/store"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/utils"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/button"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/form"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/input"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/layout"
)

type CreatePropertyVM struct {
	Name       string
	RentAmount float32
}

templ CreatePropertyPage() {
	{{
		signals := utils.Signals("create_property_signals", store.CreatePropertySignals{
			Name:       "",
			RentAmount: 0,
			Address:    "",
			FormError:  "",
		})
	}}
	@layout.Default() {
		<div class="grid grid-cols-12 gap-4">
			<div
				class="p-4 col-span-12 lg:col-start-4 lg:col-span-6 border bg-card"
			>
				// // DEBUG
				// <pre data-json-signals></pre>
				@form.Form(form.FormArgs{
					ID:     "property-form",
					Class:  "flex flex-col gap-2",
					Action: "/property/create",
					Attributes: templ.Attributes{
						"data-signals":            signals.DataSignals,
						"data-on:submit__prevent": "@post('/property/create')",
					},
				}) {
					<p class="text-destructive" data-show="$create_property_signals.form_error" data-text="'Error: ' + $create_property_signals.form_error"></p>
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "name"}) {
							Property Name *
						}
						@input.Input(input.InputArgs{
							ID:          "name",
							Name:        "name",
							Placeholder: "apt #1",
							Attributes: templ.Attributes{
								"data-bind": "create_property_signals.name",
							},
							Required: true,
						})
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "rent_amount"}) {
							Rent Amount *
						}
						@input.Input(input.InputArgs{
							ID:          "rent_amount",
							Name:        "rent_amount",
							Type:        "number",
							Placeholder: "15000",
							Attributes: templ.Attributes{
								"data-bind": "create_property_signals.rent_amount",
								"step":      "0.01", // note: by default the input can only take step = 1, meaning whole numbers
							},
							Required: true,
						})
					}
					@form.FormItem(form.FormItemArgs{}) {
						@form.FormLabel(form.FormLabelArgs{For: "address"}) {
							Address
						}
						@input.Input(input.InputArgs{
							ID:          "address",
							Name:        "address",
							Placeholder: "001 Test street, Test City",
							Attributes: templ.Attributes{
								"data-bind": "create_property_signals.address",
							},
						})
					}
					<div class="flex pt-4 justify-between">
						@button.LinkButton(button.LinkButtonArgs{
							Href:    "/dashboard",
							Variant: "secondary",
						}) {
							Back to dashboard
						}
						@button.Button(button.ButtonArgs{Type: "submit"}) {
							Submit
						}
					</div>
				}
			</div>
		</div>
	}
}
