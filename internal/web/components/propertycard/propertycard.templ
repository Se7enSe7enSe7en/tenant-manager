package propertycard

import (
	"fmt"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/utils"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/button"
)

type PropertyCardProps struct {
	Id         string
	Name       string
	RentAmount string
	Address    string
}

type PropertyCardSignals struct {
	IsBodyPanelOpen bool `json:"is_body_panel_open"`
}

templ PropertyCard(props PropertyCardProps) {
	{{
		// unique card id
		cardId := fmt.Sprintf("property_card_%v", props.Id)

		// state
		signals := utils.Signals(cardId, PropertyCardSignals{
			IsBodyPanelOpen: false,
		})
	}}
	<div
		id={ cardId }
		class="h-69 flex flex-1 flex-col overflow-auto justify-between p-4 bg-card rounded-xl border shadow-sm"
		data-signals={ signals.DataSignals }
	>
		//// header section
		<div class="h-[30.9%] flex justify-between mb-2 gap-2">
			<div class="flex gap-2">
				// <div class="flex bg-secondary items-center justify-center size-12 rounded-full border">
				// 	// TODO: add if no image condition in the future
				// 	// <span class="text-xl">P</span>
				// </div>
				<div class="flex-col">
					<p class="">{ props.Name }</p>
				</div>
			</div>
			<div class="flex justify-end align-top">
				// status
				<div
					class="flex justify-end h-6"
				>
					<div
						class="flex rounded-full border items-center justify-center gap-3 px-2 font-semibold"
					>
						<span class="flex items-center justify-center">
							<span>○</span>
						</span>
						<span class="">Unoccupied</span>
					</div>
				</div>
			</div>
		</div>
		//// body section
		<div class="h-[50%] flex flex-col pt-2 border-t gap-2">
			// if $is_body_panel_open == false
			<div class="flex flex-col gap-3" data-class:hidden={ signals.Signal("is_body_panel_open") } data-show={ signals.Not("is_body_panel_open") }>
				<div>
					<p class="text-xs">Monthly Rent: </p>
					<p>{ props.RentAmount }</p>
				</div>
				<div>
					<p class="text-xs">Address: </p>
					<p>
						if props.Address != "" {
							{ props.Address }
						} else {
							--
						}
					</p>
				</div>
			</div>
			// if $is_body_panel_open == true
			<div class="flex flex-col gap-2" data-class:hidden={ signals.Not("is_body_panel_open") } data-show={ signals.Signal("is_body_panel_open") }>
				@button.Button(button.ButtonArgs{
					Class:   "flex flex-1",
					Variant: "secondary",
				}) {
					Property Details
				}
				@button.Button(button.ButtonArgs{
					Class:   "flex flex-1",
					Variant: "destructive",
					Attributes: templ.Attributes{
						"data-on:click": fmt.Sprintf("confirm('Are you sure?') ? @delete('/property/delete?id=%v') : null", props.Id),
					},
				}) {
					Delete Property
				}
			</div>
		</div>
		//// footer section
		<div class="h-[19.1%] flex justify-center border-t pt-2 gap-3">
			@button.LinkButton(button.LinkButtonArgs{
				Class:   "flex flex-5/6",
				Variant: "secondary",
				Href:    "/tenant/create?property_id=" + props.Id,
			}) {
				Add tenant
			}
			@button.Button(button.ButtonArgs{
				Variant: "secondary",
				Attributes: templ.Attributes{
					"data-on:click": signals.Toggle("is_body_panel_open"),
				},
			}) {
				...
			}
		</div>
	</div>
}
