package tenantcard

import (
	"fmt"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/utils"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/button"
	"github.com/Se7enSe7enSe7en/tenant-manager/internal/web/components/status"
)

type TenantCardSignals struct {
	IsBodyPanelOpen bool `json:"is_body_panel_open"`
}

templ TenantCard(props TenantCardProps) {
	{{
		// unique card id
		cardId := fmt.Sprintf("tenant_card_%v", props.Id)

		// state
		signals := utils.Signals(cardId, TenantCardSignals{
			IsBodyPanelOpen: false,
		})

		isBodyPanelOpen := signals.Signal("is_body_panel_open")
	}}
	<div
		class="h-69 flex flex-1 flex-col overflow-auto justify-between p-4 bg-card rounded-xl border shadow-sm "
		data-signals={ signals.DataSignals }
	>
		//// header section
		<div class="h-[30.9%] flex justify-between mb-2 gap-3">
			<div class="flex gap-3">
				// <div class="flex size-12 items-center justify-center p-1 rounded-full ">
				// 	// TODO: add if no image condition in the future
				// 	// <span class="text-xl">T</span>
				// 	@status.Circle(status.CircleProps{Status: props.Status})
				// </div>
				<div class="flex flex-col gap-2">
					<p class="font-semibold">{ props.Name }</p>
					<p class="truncate block">{ props.Unit }</p>
				</div>
			</div>
			<div class="flex flex-col align-top">
				<div class="flex flex-col gap-2">
					@status.Badge(status.BadgeProps{Status: props.Status})
					<div class="flex flex-col p-1 justify-end">
						<p class="truncate block text-xs">Next Due Date:</p>
						<p class="font-bold">{ props.NextDueDate }</p>
					</div>
				</div>
			</div>
		</div>
		//// body section
		<div class="h-[50%] flex flex-col pt-2 border-t gap-2">
			// if $is_body_panel_open == true
			<div class="flex flex-col gap-2" data-show={ isBodyPanelOpen }>
				@button.Button(button.ButtonArgs{
					Class:   "flex flex-1",
					Variant: "secondary",
				}) {
					Tenant Details
				}
				// {{ dialogId := "dialog_" + cardId }}
				// // Modal Dialog
				// @dialog.Dialog(dialog.DialogArgs{
				// 	ID: dialogId,
				// }) {
				// 	@dialog.DialogHeader(dialog.DialogHeaderArgs{}){
				// 		Remove Tenant
				// 	}
				// 	@dialog.DialogDescription(dialog.DialogDescriptionArgs{}) {
				// 		Are you sure you want to remove tenant?
				// 	}
				// 	@dialog.DialogFooter(dialog.DialogFooterArgs{}) {
				// 		@dialog.DialogClose(dialog.DialogCloseArgs{
				// 			DialogID: dialogId,
				// 		})
				// 	}
				// }
				// debug
				// <pre data-json-signals></pre>
				@button.Button(button.ButtonArgs{
					Class:   "flex flex-1",
					Variant: "destructive",
					Attributes: templ.Attributes{
						// "data-on:click":fmt.Sprintf("@delete('/tenant/delete?id=%v')", props.Id),
						"data-on:click": fmt.Sprintf("confirm('Are you sure?') ? @delete('/tenant/delete?id=%v') : null", props.Id),
					},
				}) {
					Remove Tenant
				}
			</div>
			// if $is_body_panel_open == false
			<div class="flex flex-col gap-2" data-show={ "!" + isBodyPanelOpen }>
				<div class="flex justify-between gap-2">
					<div>
						<p class="text-xs">Email: </p>
						<p class="truncate block">{ *props.Email }</p>
					</div>
					<div>
						<p class="text-xs">Phone Number: </p>
						<p class="truncate block">{ *props.PhoneNumber }</p>
					</div>
				</div>
				<div class="flex">
					<div>
						<p class="text-xs">Monthly Rent:</p>
						<p>{ props.RentAmount }</p>
					</div>
				</div>
			</div>
		</div>
		//// footer section	
		<div class="h-[19.1%] flex justify-center border-t pt-2 gap-3">
			@button.LinkButton(button.LinkButtonArgs{
				Class: "flex flex-5/6",
				Href:  fmt.Sprintf("/trade/create?lease_id=%v", props.LeaseId),
			}) {
				Rent Collected
			}
			@button.Button(button.ButtonArgs{
				Variant: "secondary",
				Attributes: templ.Attributes{
					"data-on:click": signals.Toggle("is_body_panel_open"),
				},
			}) {
				...
			}
			// // For debugging signals
			// <pre class="text-xs" data-json-signals></pre>
		</div>
	</div>
}
